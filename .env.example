# Google Gemini API Configuration (Optional)
# If provided, the app will prioritize using the browser's local storage key.
# For local development or build integration:
GEMINI_API_KEY=AIzaSyYourGeminiApiKeyHere

# Firebase Configuration
FIREBASE_API_KEY=AIzaSyYourFirebaseApiKeyHere
FIREBASE_AUTH_DOMAIN=your-app.firebaseapp.com
FIREBASE_PROJECT_ID=your-app
FIREBASE_STORAGE_BUCKET=your-app.firebasestorage.app
FIREBASE_MESSAGING_SENDER_ID=your_sender_id
FIREBASE_APP_ID=1:your_app_id:web:your_app_hash
FIREBASE_MEASUREMENT_ID=G-YOUR_MEASUREMENT_ID
